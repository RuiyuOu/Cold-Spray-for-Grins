        </Domain>
      </Property>
      <Property name="PythonPath" id="144671.PythonPath" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
      <Property name="Script" id="144671.Script" number_of_elements="1">
        <Element index="0" value="import numpy as np&#xa;output.ShallowCopy(inputs[0].VTKObject)&#xa;&#xa;cd = inputs[0].CellData&#xa;lab = np.asarray(cd[&#x27;Label&#x27;]).astype(int)&#xa;print(&#x22;Label range:&#x22;, lab.min(), &#x22;to&#x22;, lab.max(), &#x22; distinct:&#x22;, len(np.unique(lab)))&#xa;&#xa;if lab.min() &#x3c; 1 or lab.max() &#x3e; 100:&#xa;    raise RuntimeError(&#x22;Label is not 1..100 on these cells. Check that Extract Cells By Type kept only tetrahedra.&#x22;)&#xa;&#xa;eul = np.loadtxt(&#x22;C:/ColdSprayForGrins/CrystalPlasticity/PhaseFieldTest_NoPhysics/grains3d_euler_rad.txt&#x22;)&#xa;phi1 = eul[lab - 1, 0]&#xa;&#xa;vec = np.column_stack([np.cos(phi1), np.sin(phi1), np.zeros_like(phi1)])&#xa;output.CellData.append(vec, &#x27;orient&#x27;)&#xa;output.CellData.append(np.degrees(phi1) % 360, &#x27;phi1_deg&#x27;)"/>
      </Property>
      <Property name="TimestepValues" id="144671.TimestepValues"/>
      <Property name="UpdateExtentScript" id="144671.UpdateExtentScript" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
    </Proxy>

load "gmsh"
load "iovtk"

mesh Twoh = gmshload("grains2d_fixed.msh");
Twoh = adaptmesh(Twoh, 1/50., IsMetric=true);
int maxRegion;
for (int k = 0; k < Twoh.nt; ++k)
    maxRegion = max(maxRegion, Twoh[k].region);
int n = maxRegion;
real[int] theta(n);
{
    ifstream f("grains2d_theta_rad.txt");
    for (int i = 0; i < n; i++) f >> theta(i);
}
fespace InitH(Twoh, P0);
InitH theta0;
for (int k = 0; k < Twoh.nt; k++) theta0[][k] = theta(Twoh[k].region - 1);
plot(Twoh, wait=1);

fespace OriH(Twoh,P1);
OriH Eta=1, dEta, Theta=theta0;

int[int] vtkorder2 = [1,1];
savevtk("..//PhaseFieldTest//results//InitBefore.vtk", Twoh, Theta, Eta, dataname="Orientation Alignment", order=vtkorder2);

Twoh = adaptmesh(Twoh, Theta, err = 0.05, hmin=0.01);
//Theta = theta0;
plot(Twoh, wait=true);

// Init Eta with the following: steady state equation.
// Formula: -nu^2*Lap(Eta) + (1+2s*Norm(GradTheta))*Eta -1 = 0
// Homogeneous Neumann for Eta
real nu = 0.01; real s = 1.0;
solve InitSEta(Eta,dEta) = 
	int2d(Twoh)(nu^2*(dx(Eta)*dx(dEta)+dy(Eta)*dy(dEta))
				+ Eta*dEta
				+ 2*s*sqrt(dx(Theta)^2+dy(Theta)^2)*Eta*dEta)
	- int2d(Twoh)(dEta);
plot(Eta,fill=true,value=true,wait=true);
savevtk("..//PhaseFieldTest//results//InitSteadyStateNoConstraint.vtk", Twoh, Theta, Eta, dataname="Orientation Alignment", order=vtkorder2);
Eta = (Eta > 1.0) ? 1.0 : Eta; Eta = (Eta < 0.0) ? 0.0 : Eta;
plot(Eta,fill=true,value=true,wait=true);
savevtk("..//PhaseFieldTest//results//InitSteadyState.vtk", Twoh, Theta, Eta, dataname="Orientation Alignment", order=vtkorder2);



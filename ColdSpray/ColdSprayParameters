// ----------------------- Macros -----------------------
// ------ Newark Macro ------ 
macro M(a,p) (a[0]*p[0]+a[1]*p[1]) //
// ------ Divergence ------ 
macro div(v) (dx(v[0])+dy(v[1])) //
// ------ Strain vector ------ 
macro eps(v) ([dx(v[0]),dy(v[1]),dy(v[0])+dx(v[1])]) //
// ------ Stress vector ------ 
macro Sigma(v) (Elas*eps(v)) //
// ------ Deviatoric Stress ------ 
macro Dev(p,v) ([v[0]-p, v[1]-p, v[2]-p, v[3]]) //
// ------ von Mises Stress ------ 
macro SigmaVM(DevStress) (sqrt(1.5*(DevStress[0]^2+DevStress[1]^2+DevStress[2]^2+2.*DevStress[3]^2))) //
// ------ Trace of a 3x3 matrix in the Voight notation used consistently here ------ 
macro ThreeTrace(v) (v[0]+v[1]+v[2]) //
// ----------------------- Universal Functions -----------------------
// ------ Newark constants ------ 
func real c0(real dt, real beta, real gamma){return 1./(beta*dt*dt);}
func real c1(real dt, real beta, real gamma){return 1./(beta*dt);}
func real c2(real dt, real beta, real gamma){return 1./(2.*beta) - 1.;}
func real c3(real dt, real beta, real gamma){return gamma/(beta*dt);}
func real c4(real dt, real beta, real gamma){return gamma/beta - 1.;}
func real c5(real dt, real beta, real gamma){return dt*(gamma/(2*beta) - 1.);}
// ------ Time step size ------ 
func real TimeStepSize(real GridSize, real Velocity){
	return GridSize/Velocity;}
// ----------------------- Contact Functions -----------------------
// ------ Evaluate if the traction stress is compressive ------ 
real CompTol = 0;
func bool Compression(real[int] &Tract){
	return (Tract.min < -CompTol);}
// ------ Evaluate if 2 blocks are actively overlapping ------ 
real OverlapTol = 1e-18;
func bool Overlap(mesh &Th1, mesh &Th2, mesh &Th3){
bool Overlap12 = (int2d(Th1)(chi(Th2)(x,y))+int2d(Th2)(chi(Th1)(x,y)) > OverlapTol);
bool Overlap13 = (int2d(Th1)(chi(Th3)(x,y))+int2d(Th3)(chi(Th1)(x,y)) > OverlapTol);
bool Overlap23 = (int2d(Th2)(chi(Th3)(x,y))+int2d(Th3)(chi(Th2)(x,y)) > OverlapTol);
	return ((Overlap12 || Overlap13) || Overlap23);}
// ------ Boolean to identify active contact between bodies ------ 
func bool ContactChecker
(bool Pers, mesh &Th1Def, real[int] &Tract1,
 mesh &Th2Def, real[int] &Tract2,
 mesh &Th3Def, real[int] &Tract3){
	if (Pers){return ((Compression(Tract1) || Compression(Tract2)) || Compression(Tract3));}
	else {return Overlap(Th1Def,Th2Def,Th3Def);}}
// ------ Schwarz Information Transfer ------ 
macro SchwarzTransfer
(Transx, Transy, Dirx, Diry, Lambdax, Lambday, theta, alphaS, betaS)
{
Lambdax = (1-theta)*Lambdax; Lambdax = theta*betaS*Dirx + Lambdax; Lambdax = theta*alphaS*Transx - Lambdax;
Lambday = (1-theta)*Lambday; Lambday = theta*alphaS*Transy - Lambday; Lambday = theta*betaS*Diry + Lambday;
} //
// ------ Schwarz Traction Solve ------ 
macro SchwarzTractionSolve(Th, Sh, IntRegion, Mat, Tractx, Tracty, SigmaXX, SigmaYY, SigmaXY)
{
varf VTx(u,v) = int1d(Th, IntRegion)((SigmaXX*N.x + SigmaXY*N.y)*v);
varf VTy(u,v) = int1d(Th, IntRegion)((SigmaXY*N.x + SigmaYY*N.y)*v);
real[int] Tx = VTx(0, Sh); Tractx[] = Mat^-1 * Tx;
real[int] Ty = VTy(0, Sh); Tracty[] = Mat^-1 * Ty;
}
//
// ------ Schwarz Normal Traction ------ 
macro SchwarzNormalTraction(Th, Sh, IntRegion, Mat, Tractx, Tracty, TractN)
{
varf VTn(u,v) = int1d(Th, IntRegion)( (Tractx*N.x + Tracty*N.y)*v );
real[int] Tn = VTn(0, Sh); TractN[] = Mat^-1 * Tn;
}

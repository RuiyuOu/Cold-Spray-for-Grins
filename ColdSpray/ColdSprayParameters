// ----------------------- Plasticity Functions -----------------------
// ------ Johnson-Cook Yield Stress ------ 
func real SigmaY(real A, real B, real nJC, real C, real Eps, real dEps, real T, real Tm, real m){
	real rateRatio  = max(dEps/dEps0, 1.0);
  	real theta      = min((T-T0)/(Tm-T0), 1.0);
  	real Hard	    = A + B*Eps^nJC;
  	real Rate       = 1.0 + C*log(rateRatio);
  	real Therm      = 1.0 - theta^m;
  	return Hard*Rate*Therm;}
// ------ Yield Function ------ 
func real YieldFunc(real vonMises, real A, real B, real nJC, real C, real Eps, real dEps, real T, real Tm, real m){
	return vonMises-SigmaY(A,B,nJC,C,Eps,dEps,T,Tm,m);}
// ------ Temperature Generated ------ 
func real TempGen(real rho, real A, real B, real nJC, real C, real Eps, real dEps, real T, real Tm, real m, real TQ, real Cp){
	return TQ/rho/Cp*dEps*SigmaY(A,B,nJC,C,Eps,dEps,T,Tm,m);}
// ------ Plasticity Build Field ------ 
macro PlasticBuildTrial(xx, yy, xxo, yyo, Trace, p, SigVMt, PlEpsXX, PlEpsYY, PlEpsZZ, PlEpsXY, ElEpsXXt, ElEpsYYt, ElEpsZZt, ElEpsXYt, SigXXt, SigYYt, SigZZt, SigXYt, SigXX, SigYY, SigZZ, SigXY, DevXXt, DevYYt, DevZZt, DevXYt, lambda, mu)
{
	ElEpsXXt = eps([xx,yy])[0]-eps([xxo,yyo])[0];
	ElEpsYYt = eps([xx,yy])[1]-eps([xxo,yyo])[1];
	ElEpsZZt = 0;
	ElEpsXYt = eps([xx,yy])[2]-eps([xxo,yyo])[2];
	Trace 	= ThreeTrace([ElEpsXXt,ElEpsYYt,ElEpsZZt,ElEpsXYt]);
	SigXXt 	= SigXX + lambda*Trace+2.*mu*ElEpsXXt;
	SigYYt	= SigYY + lambda*Trace+2.*mu*ElEpsYYt;
	SigZZt	= SigZZ + lambda*Trace+2.*mu*ElEpsZZt;
	SigXYt	= SigXY + mu*ElEpsXYt;
	p		= (SigXXt+SigYYt+SigZZt)/3;
	DevXXt  = Dev(p,[SigXXt,SigYYt,SigZZt,SigXYt])[0];
	DevYYt	= Dev(p,[SigXXt,SigYYt,SigZZt,SigXYt])[1];
	DevZZt	= Dev(p,[SigXXt,SigYYt,SigZZt,SigXYt])[2];
	DevXYt	= Dev(p,[SigXXt,SigYYt,SigZZt,SigXYt])[3];
	SigVMt	= SigmaVM([DevXXt,DevYYt,DevZZt,DevXYt]);
} //
// ------ Plasticity Solve ------ 
macro PlasticSolve(Sh, EqPlEps, SigVMt, Temp,DevXXt, DevYYt, DevZZt, DevXYt, DevXX, DevYY, DevZZ, DevXY,SigXX, SigYY, SigZZ, SigXY,p, PlEpsXX, PlEpsYY, PlEpsZZ, PlEpsXY,rho, A, B, nJC, C, Tm, m, TQ, Cp, mu)
{
for (int i = 0; i < Sh.ndof; i++){
	real DelG=0; 

	if (YieldFunc(SigVMt[][i],A,B,nJC,C,EqPlEps[][i],0,Temp[][i],Tm,m)>YieldFuncTol){
		DelG = Newton(SigVMt[][i], EqPlEps[][i], Temp[][i], dt, mu, rho, A, B, nJC, C, Tm, m, TQ, Cp);}
	if(DelG>0){	
	EqPlEps[][i] += DelG;
	DevXX[][i]	 = (1.- 3.*mu*DelG/SigVMt[][i])*DevXXt[][i];
	DevYY[][i]	 = (1.- 3.*mu*DelG/SigVMt[][i])*DevYYt[][i];
	DevZZ[][i]	 = (1.- 3.*mu*DelG/SigVMt[][i])*DevZZt[][i];
	DevXY[][i]	 = (1.- 3.*mu*DelG/SigVMt[][i])*DevXYt[][i];
	real[int] sn = [DevXX[][i], DevYY[][i], DevZZ[][i], DevXY[][i]];
	real factor = 1.5*DelG/SigVMt[][i];
	PlEpsXX[][i] += factor*sn[0];
	PlEpsYY[][i] += factor*sn[1];
	PlEpsZZ[][i] += factor*sn[2];
	PlEpsXY[][i] += 2*factor*sn[3];
	Temp[][i] 	 += TempGen(rho,A,B,nJC,C,EqPlEps[][i],DelG,Temp[][i],Tm,m,TQ,Cp);
	SigXX[][i]	 = p[][i] + DevXX[][i];
	SigYY[][i]	 = p[][i] + DevYY[][i];
	SigZZ[][i]	 = p[][i] + DevZZ[][i];
	SigXY[][i]	 = DevXY[][i];
	}
}
}
//
// ------ Newton-Raphson ------ 
func real Newton(real vmTrial, real epsEqOld, real Told, real dt, real mu,
                  real rho, real A, real B, real nJC, real C, real Tm, real m, real TQ, real Cp)
{real dg = 0;
// --- Start For : Newton --- 
for (int it = 0; it < newtiters; it++){
real epsRate = dg/dt;
real Tguess  = Told + TempGen(rho,A,B,nJC,C,epsEqOld+dg,dg,Told,Tm,m,TQ,Cp);
real sY      = SigmaY(A,B,nJC,C,epsEqOld+dg,epsRate,Tguess,Tm,m);
real R       = vmTrial - 3.*mu*dg - sY;
if (abs(R) < newttol){break;}

real h        = max(dg*1.0e-6, 1.0e-12);
real epsRateh = (dg+h)/dt;
real Tguessh  = Told + TempGen(rho,A,B,nJC,C,epsEqOld+dg+h,dg+h,Told,Tm,m,TQ,Cp);
real sYh      = SigmaY(A,B,nJC,C,epsEqOld+dg+h,epsRateh,Tguessh,Tm,m);
real Rh       = vmTrial - 3.*mu*(dg+h) - sYh;

real dRdg = (Rh-R)/h;
if (abs(dRdg) < 1.0e-20){break;}

real dgNew = dg - R/dRdg;
if (dgNew < 0.0) dgNew = 0.0;
dg = dgNew;
if(it==newtiters){cout << "Newton iteration limit reached" << endl;}
} // --- End For : Newton --- 
return dg;}// --- End Newton --- 

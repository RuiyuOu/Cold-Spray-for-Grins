// Copper particle
real rho  	= 8960.; 	// Density
real E    	= 117e9; 	// Young's modulus
real nu   	= 0.34;  	// Poisson modulus
real A    	= 90e6;  	// 1st Johnson-Cook hardening parameter
real B    	= 292e6;  	// 2nd Johnson-Cook hardening parameter
real nJC  	= 0.31;   	// Johnson-Cook hardening strain exponent
real C    	= 0.025;  	// Johnson-Cook rate parameter
real m    	= 1.09;   	// Johnson-Cook thermal exponent
real dEps0 	= 1.0;   	// Reference strain rate

real Tm   	= 1356.;  	// Melting temp
real Cp   	= 385.;		// Specific heat
real TQ  	= 0.9;		// Taylor-Quincy Heat fraction
real Tk 	= TQ/(rho*Cp); 	// Temp fraction
real T0    	= 300.;		// Starting temp

real vimp  	= -500.;	// Impact velocity

// Lame 
real mu     = E/(2.*(1.+nu));
real lambda = E*nu/((1.+nu)*(1.-2.*nu));

// Beta Newark parameters
real beta 	= 0.25;
real gamma 	= 0.5;

// Beta Newmark constants
func real c0(real dt){return (1./(beta*dt*dt));}
func real c1(real dt){return (1./(beta*dt));}
func real c2(real dt){return (1./(2.*beta) - 1.);}
func real c3(real dt){return (gamma/(beta*dt));}
func real c4(real dt){return (gamma/beta - 1.);}
func real c5(real dt){return (dt*(gamma/(2*beta) - 1.));}

// Thermomechanics

// Elasticity tensor
func Elas = [	[2*mu+lambda	, lambda		, 0 ],
				[lambda			, 2*mu+lambda	, 0 ],
				[0				, 0				, mu]	];

// Wave speeds
real ps = sqrt((lambda+2*mu)/rho);
real ss = sqrt(mu/rho);

// Time step size
func real TimeStepSize(real GridSize){
	return GridSize/ps;
}

// Johnson-Cook Yield Stress
func real SigmaY(real Eps, real dEps, real T){
	real rateRatio  = max(dEps/dEps0, 1.0);
  	real theta      = min((T-T0)/(Tm-T0), 1.0);
  	real Hard	    = A + B*Eps^nJC;
  	real Rate       = 1.0 + C*log(rateRatio);
  	real Therm      = 1.0 - theta^m;
  	return Hard*Rate*Therm;
}

// Yield Function
func real YieldFunc(real vonMises, real Eps, real dEps, real T){
	return vonMises-SigmaY(Eps,dEps,T);
}

// Residual
func real Residual(real vonMises, real Eps, real T, real DelG, real dt){
	return YieldFunc(vonMises,Eps+DelG,DelG/dt,T+0)-3*mu*DelG;
}

// Temperature Generated
func real TempGen(real Eps, real DelG, real T, real dt){
	return Tk*DelG*SigmaY(Eps,DelG/dt,T);
}

// Macros M and K as described in the PDF
macro M(a) (a[0]*vi+a[1]*vj) //
macro K(a) (lambda*(div(a)*div([vi,vj]))+2.*mu*eps(a)'*eps([vi,vj])) // 

// Divergence
macro div(v) (dx(v[0])+dy(v[1])) //
// Strain vector
macro eps(v) ([dx(v[0]),dy(v[1]),dy(v[0])+dx(v[1])]) //
// Stress vector
macro Sigma(v) (Elas*eps(v)) //

// Unnest this to use what is needed. SigmaVM(Dev(Sigma([xx,yy])))
// Deviatoric Stress
macro Dev(p,v) ([v[0]-p, v[1]-p, v[2]-p, v[3]]) //
// von Mises Stress
macro SigmaVM(DevStress) (sqrt(1.5*(DevStress[0]^2+DevStress[1]^2+DevStress[2]^2+2.*DevStress[3]^2))) //
// Build 2x2 stress from hydrostatic and deviatoric
macro TwoSigma(p,Dev) ([p+Dev[0],p+Dev[1],Dev[3]]) //
// Build 3x3 stress from hydrostatic and deviatoric
macro ThreeSigma(p,Dev) ([p+Dev[0],p+Dev[1],p+Dev[2],Dev[3]]) //

macro ThreeTrace(v) (v[0]+v[1]+v[2]) //
 
load "iovtk"
include "PlasticGeometry"
include "PlasticParameters"

string outdir = "..//Plasticity//results//";
string filenum;

real T 		= 50e-9;
real MinGridSize = h[].min;
real dt 	= TimeStepSize(MinGridSize);
real steps 	= T/dt;	

// Initial conditions
xx[]  		= 0;
xxo[] 		= 0;
[vx,vy] 	= [vimp,0];
[vxo,vyo]	= [vimp,0];
ax[] 		= 0;
axo[]		= 0;

int[int] vtkorder = [1,1,1];

for (int n = 0; n < steps; n++)
{
    real t  = (n+1)*dt;

    problem BetaNewark([xx,yy],[vi,vj])
        = int2d(Ph)(
              	c0(dt)*rho*M([xx,yy])+
				K([xx,yy])
			)
        - int2d(Ph)(
				c0(dt)*rho*M([xxo,yyo]) + c1(dt)*rho*M([vxo,vyo]) + c2(dt)*rho*M([axo,ayo])
			)
        + on(left, xx=0);

    BetaNewark;
	
	// Update the fields

    // New acceleration from Newmark
    // uan = c0*(x_i+1 - x_i) - c1*vxo - c2*axo
    ax[] =  xx[];
    ax[] -= xxo[];
    ax[] *= c0(dt);
    ax[] -= c1(dt)*vx[];
    ax[] -= c2(dt)*axo[];

    // New velocity from Newark
	// uvn = c3*(x_i+1 - x_i) - c4*vxo - c5*axo
    vx[] =  xx[];
	vx[] -= xxo[];
	vx[] *= c3(dt);
    vx[] -= c4(dt)*vxo[];
	vx[] -= c5(dt)*axo[];

    xxo[] = xx[];
	vxo[] = vx[];
	axo[] = ax[];

	
	// Save data

	// Block deformation
	mesh PhDeformed = movemesh(Ph, [x+xx, y+yy]);
	// Pressure and shear waves 
	pw = dx(xx)+dy(yy);
	sw = dy(xx)-dx(yy);

	if (n%3==0){
		if 		(n < 10) 	filenum = "000"	+n;
		else if (n < 100) 	filenum = "00"	+n;
		else if (n < 1000)	filenum = "0"   +n;
		else 				filenum = n;
	
    	savevtk(outdir+"Elastic"+filenum+".vtu", 
				PhDeformed, 
				[xx,yy], pw, sw, 
				dataname="displacement pressurewave shearwave",
				order=vtkorder);
	}
}

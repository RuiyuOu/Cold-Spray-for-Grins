load "iovtk"
include "PlasticGeometry"
include "PlasticParameters"

string outdir = "..//Plasticity//results//";
string filenum;

real T 		= 50e-9;
real MinGridSize = CFL[].min;
real dt 	= TimeStepSize(MinGridSize);
real steps 	= T/dt;	

// Initial conditions
xx[]  		= 0;
xxo[] 		= 0;
[vx,vy] 	= [vimp,0];
[vxo,vyo]	= [vimp,0];
ax[] 		= 0;
axo[]		= 0;

int[int] vtkorder = [1,1,1,1];

real C0 = c0(dt);
real C1 = c1(dt);
real C2 = c2(dt);
real C3 = c3(dt);
real C4 = c4(dt);
real C5 = c5(dt);

problem Plastic([xx,yy],[vi,vj])
	= int2d(Ph)(
              	C0*rho*M([xx,yy])+
				K([xx,yy])
				)
	  - int2d(Ph)(
				C0*rho*M([xxo,yyo])+
				C1*rho*M([vxo,vyo])+
				C2*rho*M([axo,ayo])
				)
	  + on(left, xx=0);

for (int n = 0; n < steps; n++)
{
    real t  = (n+1)*dt;

    Plastic;
	
	// Update the fields

    // New acceleration from Newmark
    // uan = c0*(x_i+1 - x_i) - c1*v_i - c2*a_i
    ax[] =  xx[];
    ax[] -= xxo[];
    ax[] *= C0;
    ax[] -= C1*vxo[];
    ax[] -= C2*axo[];

    // New velocity from Newark
	// uvn = c3*(x_i+1 - x_i) - c4*v_i - c5*a_i
    vx[] =  xx[];
	vx[] -= xxo[];
	vx[] *= C3;
    vx[] -= C4*vxo[];
	vx[] -= C5*axo[];

	// Carry over 
    xxo[] = xx[];
	vxo[] = vx[];
	axo[] = ax[];
	
	// ------------- Extra junk just to make the code work ------------------------
	ElEpsXXt= eps([xx,yy])[0]-PlEpsXX;
	ElEpsYYt= eps([xx,yy])[1]-PlEpsYY;
	ElEpsZZt= 0-PlEpsZZ;
	ElEpsXYt= eps([xx,yy])[2]-PlEpsXY;
	Trace 	= ThreeTrace([ElEpsXXt,ElEpsYYt,ElEpsZZt,ElEpsXYt]);
	p		= (lambda+2/3*mu)*Trace; // it has sum of 2muSig_ii in hydrostatic
	SigXXt 	= lambda*Trace+2*mu*ElEpsXXt;
	SigYYt	= lambda*Trace+2*mu*ElEpsYYt;
	SigZZt	= lambda*Trace+2*mu*ElEpsZZt;
	SigXYt	= mu*ElEpsXYt;
	DevXXt  = Dev(p,[SigXXt,SigYYt,SigZZt,SigXYt])[0];
	DevYYt	= Dev(p,[SigXXt,SigYYt,SigZZt,SigXYt])[1];
	DevZZt	= Dev(p,[SigXXt,SigYYt,SigZZt,SigXYt])[2];
	DevXYt	= Dev(p,[SigXXt,SigYYt,SigZZt,SigXYt])[3];
	SigVMt	= SigmaVM([DevXXt,DevYYt,DevZZt,DevXYt]);

	// Save data
	if (n%3==0){

		real KE = 0.5*rho*int2d(Ph)([vx,vy]'*[vx,vy]);
		real EE = 0.5*int2d(Ph)(eps([xx,yy])'*Elas*eps([xx,yy]));

		cout << "Kinetic Energy" << KE << endl;
		cout << "Elastic Energy" << EE << endl;
		cout << "Total Energy" << KE+EE << endl;

		// Block deformation
		mesh PhDeformed = movemesh(Ph, [x+xx, y+yy]);
		// Pressure and shear waves 
		pw = dx(xx)+dy(yy);
		sw = dy(xx)-dx(yy);

		if 		(n < 10) 	filenum = "000"	+n;
		else if (n < 100) 	filenum = "00"	+n;
		else if (n < 1000)	filenum = "0"   +n;
		else 				filenum = n;
	
    	savevtk(outdir+"Elastic"+filenum+".vtu", 
				PhDeformed, 
				[xx,yy], pw, sw, SigVMt,
				dataname="Displacement PressureWave ShearWave vonMisesStress",
				order=vtkorder);
	}
}
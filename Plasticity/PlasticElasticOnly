load "iovtk"
include "PlasticGeometry"
include "PlasticParameters"

string outdir = "..//Plasticity//results//";
string filenum;

real T 		= 50e-9;
real MinGridSize = h[].min;
real dt 	= TimeStepSize(MinGridSize);
real steps 	= T/dt;	

// Initial conditions
xx[]  		= 0;
xxo[] 		= 0;
[vx,vy] 	= [vimp,0];
[vxo,vyo]	= [vimp,0];
ax[] 		= 0;
axo[]		= 0;
PlEpsXX=0;PlEpsYY=0;PlEpsXY=0;PlEpsZZ=0; 
EqPlEps=0; dEqPlEps=0;
SigXX=0; SigYY=0; SigXY=0; SigZZ=0;
Temp=T0;
SigVM=0;
SigY=SigmaY(EqPlEps,dEqPlEps,Temp);

int[int] vtkorder = [1,1,1,1];

problem Plastic([xx,yy],[vi,vj])
	= int2d(Ph)(
              	c0(dt)*rho*M([xx,yy])+
				K([xx,yy])
				)
	  - int2d(Ph)(
				c0(dt)*rho*M([xxo,yyo])+
				c1(dt)*rho*M([vxo,vyo])+
				c2(dt)*rho*M([axo,ayo])+
				eps([vi,vj])'*Elas*[PlEpsXX,PlEpsYY,PlEpsXY]
				)
	  + on(left, xx=0);

for (int n = 0; n < steps; n++)
{
    real t  = (n+1)*dt;

    Plastic;
	
	// Update the fields

    // New acceleration from Newmark
    // uan = c0*(x_i+1 - x_i) - c1*vxo - c2*axo
    ax[] =  xx[];
    ax[] -= xxo[];
    ax[] *= c0(dt);
    ax[] -= c1(dt)*vx[];
    ax[] -= c2(dt)*axo[];

    // New velocity from Newark
	// uvn = c3*(x_i+1 - x_i) - c4*vxo - c5*axo
    vx[] =  xx[];
	vx[] -= xxo[];
	vx[] *= c3(dt);
    vx[] -= c4(dt)*vxo[];
	vx[] -= c5(dt)*axo[];

	// Carry over 
    xxo[] = xx[];
	vxo[] = vx[];
	axo[] = ax[];
	
	// Save data
	if (n%3==0){
		// Block deformation
		mesh PhDeformed = movemesh(Ph, [x+xx, y+yy]);
		// Pressure and shear waves 
		pw = dx(xx)+dy(yy);
		sw = dy(xx)-dx(yy);
		SigVMw = SigmaVM(Dev(Sigma([xx,yy])));

		if 		(n < 10) 	filenum = "000"	+n;
		else if (n < 100) 	filenum = "00"	+n;
		else if (n < 1000)	filenum = "0"   +n;
		else 				filenum = n;
	
    	savevtk(outdir+"Elastic"+filenum+".vtu", 
				PhDeformed, 
				[xx,yy], pw, sw, SigVMw,
				dataname="Displacement PressureWave ShearWave vonMisesStress",
				order=vtkorder);
	}
}
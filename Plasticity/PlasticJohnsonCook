// Restarting and reading a specifically computational plasticity book
load "iovtk"
include "PlasticGeometry"
include "PlasticParameters"

string outdir = "..//Plasticity//results//";
string filenum;

real T 		= 50e-9;
real MinGridSize = h[].min;
real dt 	= TimeStepSize(MinGridSize);
real steps 	= T/dt;	
int  iters	= 100;
int  newtiters 	= 500;
real itertol	= 1e-9; 
real YieldFuncTol 	= 0;
real newttol 	= 1e-9;

// Initial conditions
xx[]  		= 0;
xxo[] 		= 0;
[vx,vy] 	= [vimp,0];
[vxo,vyo]	= [vimp,0];
ax[] 		= 0;
axo[]		= 0;
PlEpsXX=0;PlEpsYY=0;PlEpsXY=0;PlEpsZZ=0; 
dPlEpsXX=0;dPlEpsYY=0;dPlEpsXY=0;dPlEpsZZ=0; 
EqPlEps=0; dEqPlEps=0; 
Temp=T0; TGen=0; TGenOld=0; 
SigVM=0;
SigY=SigmaY(EqPlEps,dEqPlEps,Temp); // Should default to A 

int[int] vtkorder = [1,1,1,1,1];

// Newark
problem Plastic([xx,yy],[vi,vj])
	= int2d(Ph)(
              	c0(dt)*rho*M([xx,yy])+
				K([xx,yy])
				)
	  - int2d(Ph)(
				c0(dt)*rho*M([xxo,yyo])+
				c1(dt)*rho*M([vxo,vyo])+
				c2(dt)*rho*M([axo,ayo])+
				eps([vi,vj])'*Elas*[PlEpsXX,PlEpsYY,PlEpsXY]+
				eps([vi,vj])'*Elas*[dPlEpsXX,dPlEpsYY,dPlEpsXY]
				)
	  + on(left, xx=0);

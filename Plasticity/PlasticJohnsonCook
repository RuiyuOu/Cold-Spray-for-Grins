load "iovtk"
include "PlasticGeometry"
include "PlasticParameters"

string outdir = "..//Plasticity//results//";
string filenum;

// CFL information
fespace P0h(Ph,P0);
P0h h = hTriangle;
real hmin = h[].min;
cout << "Smallest element size (hTriangle): " << hmin << endl;
real ps = sqrt((lambda+2*mu)/rho);
real ss = sqrt(mu/rho);
real pt = hmin/ps;
real st = hmin/ss;
cout << "Pressure wave speed: " << ps << endl;
cout << "Shear wave speed: " << ss << endl;
cout << "Time step for pressure: " << pt << endl;
cout << "Time step for shear: " << st << endl;

real T 		= 50e-9;
real dt 	= pt*0.98;
real steps 	= T/dt;

fespace Kh(Ph,[P2,P2]);        
Kh [un,vn]; 			// Old displacement
Kh [uvn,vvn];			// Old velocity
Kh [uan,van];			// Old acceleration
Kh [vold,dvold];		// Dummy vars
Kh [aold,daold];		

// Initial conditions
un[]  = 0;
[uvn,vvn] = [vimp,0];
uan[] = 0;
aold[]= 0;
[vold,dvold]= [vimp,0];

int[int] vtkorder = [1,1,1];

for (int n = 0; n < steps; n++)
{
    real t  = (n+1)*dt;

    problem BetaNewark([ux,uy],[vx,vy])
        = int2d(Ph)(
              	c0*rho*M([ux,uy])+
				K([ux,uy])
			)
        - int2d(Ph)(
				c0*rho*M([un,vn]) + c1*rho*M([uvn,vvn]) + c2*rho*M([uan,van])
			)
        + on(left, ux=0);

    BetaNewark;
	
	// Update the fields

    // New acceleration from Newmark
    // uan = c0*(px - un) - c1*uvn - c2*aold
    uan[] = ux[];
    uan[] -= un[];
    uan[] *= c0;
    uan[] -= c1*uvn[];
    uan[] -= c2*aold[];

    // New velocity from Newark
	// uvn = c3*(px - un) - c4*vold - c5*aold
    uvn[] = ux[];
	uvn[] -= un[];
	uvn[] *= c3;
    uvn[] -= c4*vold[];
	uvn[] -= c5*aold[];

    un[] = ux[];
	aold[] = uan[];
	vold[] = uvn[];
	
	// Save data

	// Block deformation
	mesh PhDeformed = movemesh(Ph, [x+ux, y+uy]);
	// Pressure and shear waves 
	pw = dx(ux)+dy(uy);
	sw = dy(ux)-dx(uy);

	if (n%3==0){
		if 		(n < 10) 	filenum = "000"	+n;
		else if (n < 100) 	filenum = "00"	+n;
		else if (n < 1000)	filenum = "0"   +n;
		else 				filenum = n;
	
    	savevtk(outdir+"Elastic"+filenum+".vtu", 
				PhDeformed, 
				[ux,uy], pw, sw, 
				dataname="displacement pressurewave shearwave",
				order=vtkorder);
	}
}
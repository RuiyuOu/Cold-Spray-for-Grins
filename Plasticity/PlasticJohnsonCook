load "iovtk"
include "PlasticGeometry"
include "PlasticParameters"

string outdir = "..//Plasticity//results//";
string filenum;

real T 		= 50e-9;
real MinGridSize = CFL[].min;
real dt 	= TimeStepSize(MinGridSize);
real steps 	= T/dt;	
int  iters	= 25;
int  newtiters 	= 25;
real itertol	= 1e-9; 
real YieldFuncTol 	= 0;
real newttol 	= 1e-9;

// Initial conditions
xx[]  		= 0;
xxo[] 		= 0;
[vx,vy] 	= [vimp,0];
[vxo,vyo]	= [vimp,0];
ax[] 		= 0;
axo[] 		= 0;
EqPlEps=0;
p=0;
SigVM=0; 
Temp=T0;

real EStart = 0.5*rho*2*3*scale^2*vimp^2;
real HMax 	= rho*Cp*(Tm-T0)*2*3*scale^2;
cout << "EStart" << EStart << endl;
cout << "Max heat energy" << HMax << endl;

int[int] vtkorder = [1,1,1,1,1];

real C0 = c0(dt);
real C1 = c1(dt);
real C2 = c2(dt);
real C3 = c3(dt);
real C4 = c4(dt);
real C5 = c5(dt);

// Newark 
problem Newark([xx,yy],[vi,vj])
	= int2d(Ph)( 
				C0*rho*M([xx,yy])+
				eps([vi,vj])'*Elas*eps([xx,yy]) // Including stress from incrementing strain
				)
	+ int2d(Ph)(eps([vi,vj])'*[SigXX,SigYY,SigXY]) // Old stress from old strain
	- int2d(Ph)(
				C0*rho*M([xxo,yyo])+
				C1*rho*M([vxo,vyo])+
				C2*rho*M([axo,ayo])+
				eps([vi,vj])'*Elas*eps([xxo,yyo])  // Including stress from incrementing strain
				)
	+ on(left, xx=0);

// Newton-Raphson. Well more of a secant
func real Newton(real vmTrial, real epsEqOld, real Told)
{
	real dg = 0;
  	for (int it = 0; it < newtiters; it++){
    	real epsRate = dg/dt;
  		real Tguess  = Told + TempGen(epsEqOld+dg, dg, Told, dt);
    	real sY      = SigmaY(epsEqOld+dg, epsRate, Tguess);
    	real R       = vmTrial - 3.*mu*dg - sY;
    	if (abs(R) < newttol) break;

    	real h        = max(dg*1.0e-6, 1.0e-12);
    	real epsRateh = (dg+h)/dt;
    	real Tguessh  = Told + TempGen(epsEqOld+dg+h, dg+h, Told, dt);
    	real sYh      = SigmaY(epsEqOld+dg+h, epsRateh, Tguessh);
    	real Rh       = vmTrial - 3.*mu*(dg+h) - sYh;

    	real dRdg = (Rh-R)/h;
    	if (abs(dRdg) < 1.0e-20) break;

    	real dgNew = dg - R/dRdg;
    	if (dgNew < 0.0) dgNew = 0.0;
    	dg = dgNew;
		if(it==newtiters) cout << "Newton iteration limit reached" << endl;
  	}
	
  	return dg;
}

for ( int nt = 0; nt < steps; nt++ ){

	Newark;

	ElEpsXXt= eps([xx,yy])[0]-eps([xxo,yyo])[0];
	ElEpsYYt= eps([xx,yy])[1]-eps([xxo,yyo])[1];
	ElEpsZZt= 0;
	ElEpsXYt= eps([xx,yy])[2]-eps([xxo,yyo])[2];
	Trace 	= ThreeTrace([ElEpsXXt,ElEpsYYt,ElEpsZZt,ElEpsXYt]);
	SigXXt 	= SigXX + lambda*Trace+2.*mu*ElEpsXXt;
	SigYYt	= SigYY + lambda*Trace+2.*mu*ElEpsYYt;
	SigZZt	= SigZZ + lambda*Trace+2.*mu*ElEpsZZt;
	SigXYt	= SigXY + mu*ElEpsXYt;
	p 		= (SigXXt+SigYYt+SigZZt)/3.;
	DevXXt  = Dev(p,[SigXXt,SigYYt,SigZZt,SigXYt])[0];
	DevYYt	= Dev(p,[SigXXt,SigYYt,SigZZt,SigXYt])[1];
	DevZZt	= Dev(p,[SigXXt,SigYYt,SigZZt,SigXYt])[2];
	DevXYt	= Dev(p,[SigXXt,SigYYt,SigZZt,SigXYt])[3];
	SigVMt	= SigmaVM([DevXXt,DevYYt,DevZZt,DevXYt]);
	
	for (int i = 0; i < Sh.ndof; i++){
		real DelG=0; 

		if (YieldFunc(SigVMt[][i],EqPlEps[][i],0,Temp[][i])>YieldFuncTol){
			DelG = Newton(SigVMt[][i], EqPlEps[][i], Temp[][i]);
		}
		
		EqPlEps[][i] += DelG;
		DevXX[][i]	 = (1.- 3.*mu*DelG/SigVMt[][i])*DevXXt[][i];
		DevYY[][i]	 = (1.- 3.*mu*DelG/SigVMt[][i])*DevYYt[][i];
		DevZZ[][i]	 = (1.- 3.*mu*DelG/SigVMt[][i])*DevZZt[][i];
		DevXY[][i]	 = (1.- 3.*mu*DelG/SigVMt[][i])*DevXYt[][i];
		real[int] sn = [DevXX[][i], DevYY[][i], DevZZ[][i], DevXY[][i]];
		real factor = 1.5*DelG/SigVMt[][i];
		PlEpsXX[][i] += factor*sn[0];
		PlEpsYY[][i] += factor*sn[1];
		PlEpsZZ[][i] += factor*sn[2];
		PlEpsXY[][i] += 2*factor*sn[3];
		// I think this is still heating up too much. 
		// There is not enough starting kinetic energy to generate all the heat so far.
		Temp[][i] 	 += TempGen(EqPlEps[][i], DelG, Temp[][i], dt);
		SigXX[][i]	 = p[][i] + DevXX[][i];
		SigYY[][i]	 = p[][i] + DevYY[][i];
		SigZZ[][i]	 = p[][i] + DevZZ[][i];
		SigXY[][i]	 = DevXY[][i];
	}
	
	// Carry over
    // New acceleration from Newmark
    // uan = c0*(x_i+1 - x_i) - c1*vxo - c2*axo
    ax[] =  xx[];
    ax[] -= xxo[];
    ax[] *= C0;
    ax[] -= C1*vxo[];
    ax[] -= C2*axo[];

    // New velocity from Newark
	// uvn = c3*(x_i+1 - x_i) - c4*vxo - c5*axo
	vx[] =  xx[];
	vx[] -= xxo[];
	vx[] *= C3;
	vx[] -= C4*vxo[];
	vx[] -= C5*axo[];

	// Carry over 
    xxo[] = xx[];
	vxo[] = vx[];
	axo[] = ax[];
	if (nt%3==0){
		
		real KE = 0.5*rho*int2d(Ph)([vx,vy]'*[vx,vy]);
		real EE = 0.5*int2d(Ph)([SigXX,SigYY,SigXY]'*(eps([xx,yy])-[PlEpsXX,PlEpsYY,PlEpsXY]));
		real TE = rho*Cp*int2d(Ph)(Temp-T0);
		real PE = B/(nJC+1)*int2d(Ph)(EqPlEps^(nJC+1));
		
		cout << "Energy Start" << EStart
       	<< "   KE+EE+TE " << KE+EE+TE << endl;

		cout << "Kinetic" << KE
       	<< "   Elastic" << EE
       	<< "   Thermal" << TE 
		<< "   Plastic" << PE << endl;
	
		// Block deformation
		mesh PhDeformed = movemesh(Ph, [x+xx, y+yy]);
		// Pressure and shear waves 
		pw = dx(xx)+dy(yy);
		sw = dy(xx)-dx(yy);
		SigVM = SigmaVM([DevXX,DevYY,DevZZ,DevXY]);

		if 		(nt < 10) 	filenum = "000"	+nt;
		else if (nt < 100) 	filenum = "00"	+nt;
		else if (nt < 1000)	filenum = "0"   +nt;
		else 				filenum = nt;
	
    	savevtk(outdir+"Plastic"+filenum+".vtu", 
				PhDeformed, 
				[xx,yy], pw, sw, SigVM, Temp,
				dataname="Displacement PressureWave ShearWave vonMisesStress Temperature",
				order=vtkorder);
	}
}
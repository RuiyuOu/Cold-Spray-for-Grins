int left 	= 1;
int bottom	= 2;
int right 	= 3;
int top		= 4;

int nw = 20;
int nl = 30;
real scale = 25e-6; // 25 micrometers

border S1(t=0,1){ x=0;   			y=scale*(1-2*t);   	label=left; 	}
border S2(t=0,1){ x=scale*(3*t);   	y=scale*(-1);   	label=bottom; 	}
border S3(t=0,1){ x=scale*(3); 		y=scale*(-1+2*t);   label=right; 	}
border S4(t=0,1){ x=scale*(3-3*t);  y=scale*(1); 		label=top; 		}

mesh Ph	= buildmesh(S1(nw)+S2(nl)+S3(nw)+S4(nl));

// Taylor-Hood
// Quadratic vector space
fespace Vh(Ph, [P2, P2]);
// Linear scalar space
fespace Sh(Ph, P1);

Vh [xx, yy]; 	// Displacement
Vh [xxo,yyo]; 	// Old displacement
Vh [vx, vy]; 	// Velocity
Vh [vxo,vyo];	// Old velocity
Vh [ax, ay];	// Acceleration
Vh [axo,ayo];	// Old acceleration
Vh [vi,	vj];	// Test functions

Sh PlEpsXX, PlEpsXY, PlEpsYY, PlEpsZZ; 	// Plastic strain
Sh EqPlEps, dEqPlEps;	// Equivalent plastic strain, equivalent plastic strain rate
Sh SigXX, SigYY, SigXY, SigZZ; 	// ii component of the stress tensor
Sh SigY, SigVM; 		// Yield stress, von Mises stress
Sh Temp, TGen;			// Temperature, Temperature generated by plasticity

// Waves 
fespace Wh(Ph,P1);
Wh pw, sw; // Pressure wave, shear wave

// CFL information
fespace P0h(Ph,P0);
P0h h = hTriangle;
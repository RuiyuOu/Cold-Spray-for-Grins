// -------------- Static Functions & Macros --------------
varf StaRes([dX,dY,dZ,dp],[V1,V2,V3,V4]) = int3d(Th,qforder=StaIntOrd)(
  // P : W = P : Grad Tests
  P11*W11 + P12*W12 + P13*W13 + P21*W21 + P22*W22 + P23*W23 + P31*W31 + P32*W32 + P33*W33
  // Pressure term (J-1)*test
  + (Jdet-1.)*V4 )
  + on(5,6, dX=0, dY=0, dZ=0);

varf StaJac([dX,dY,dZ,dp],[V1,V2,V3,V4]) = int3d(Th,qforder=StaIntOrd)(
  KUU
  + dp*cofW // Kup
  + V4*cofG ) // Kpu
  + on(5,6, dX=0, dY=0, dZ=0);

func real TensileForce(){return int2d(Th,6)(P33);}

macro StaticSolve() {
cout << "In Newton Solve" << endl;
for( int nr = 0; nr < StaNewtMax; nr++){
  matrix J = StaJac(Vec,Vec, solver=sparsesolver);
  real[int] r = StaRes(0,Vec);
  r = -r;
  dX[] = J^-1 * r;
  X[] += dX[];
  AbsErr = int3d(Th)(dX[]'*dX[]);
  cout << AbsErr << endl;
if( AbsErr < StaAbsErr ){
  cout << "Newton converged in " << nr + 1 << " steps. Err: " << AbsErr << endl;
  break;
}
}
cout << "Exiting Newton Solve" << endl;
} //

macro StaticResidue() {
Residue = int2d(Th, 6)(P33) - TargetTensile;
} //

macro UpdateSecant() {
SearchLow  = SearchHigh;
ResidueLow = ResidueHigh;
SearchHigh = SearchInit;
ResidueHigh= Residue;
SearchInit = SearchHigh - ResidueHigh*(SearchHigh-SearchLow)/(ResidueHigh-ResidueLow);
} //

macro UpdateBisect() {
if( Residue < 0 ){ SearchLow = SearchInit; }
else{ SearchHigh = SearchInit; }
SearchInit = (SearchHigh+SearchLow)/2;
} //
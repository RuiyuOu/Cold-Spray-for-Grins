// -------------- Shared Macros --------------
// Note: We use cofactors here to avoid any and all ill conditioned divisions

// Deformation gradient: F = du/dx = I + dX/dx. 
macro F11() (1+dx(X)) //
macro F12() (dy(X)) //
macro F13() (dz(X)) //
macro F21() (dx(Y)) //
macro F22() (1+dy(Y)) //
macro F23() (dz(Y)) //
macro F31() (dx(Z)) //
macro F32() (dy(Z)) //
macro F33() (1+dz(Z)) //

// Cofactor matrix: cof F = J F^-T = dJ/dF 
macro cof11() (F22*F33-F23*F32) //
macro cof12() (F23*F31-F21*F33) //
macro cof13() (F21*F32-F22*F31) //
macro cof21() (F13*F32-F12*F33) //
macro cof22() (F11*F33-F13*F31) //
macro cof23() (F12*F31-F11*F32) //
macro cof31() (F12*F23-F13*F22) //
macro cof32() (F13*F21-F11*F23) //
macro cof33() (F11*F22-F12*F21) //

// Determinant of F: J = det F = F1i CofF1i
macro Jdet() (F11*cof11+F12*cof12+F13*cof13) //

// Inverse of F: F^-1 = CofF / J ; Note: J approx 1 here so no issue with division.
macro Fi11() (cof11/Jdet) //
macro Fi12() (cof21/Jdet) //
macro Fi13() (cof31/Jdet) //
macro Fi21() (cof12/Jdet) //
macro Fi22() (cof22/Jdet) //
macro Fi23() (cof32/Jdet) //
macro Fi31() (cof13/Jdet) //
macro Fi32() (cof23/Jdet) //
macro Fi33() (cof33/Jdet) //

// Left Cauchy-Green: C = F^T F ; Note: Only relevant parts of C, as fibers are only in yz.
macro C11() (F11^2+F21^2+F31^2) //
macro C22() (F12^2+F22^2+F32^2) //
macro C33() (F13^2+F23^2+F33^2) //
macro C23() (F12*F13+F22*F23+F32*F33) //

// Fiber Orientation: (0, cos(gamma), sin(gamma))
macro cosg() (cos(gamma)) //
macro sing() (sin(gamma)) //

// Fiber Structure Tensor: H = 1/4pi Integral rho M otimes M 
macro H11() (kappa) //
macro H22() (kappa+(1.-3.*kappa)*cosg^2) //
macro H33() (kappa+(1.-3.*kappa)*sing^2) //
macro H23(sgn) ((1.-3.*kappa)*cosg*sing*(sgn)) //

// Structure Strain Invariant: Ei = Hi : C - 1
macro Es(sgn) (H11*C11+H22*C22+H33*C33+2.*H23(sgn)*C23-1.) //

// Stress Function 1: psi_fi' = dPsi_fi/dE
macro dpsi(sgn) (k1*Es(sgn)*exp(k2*Es(sgn)^2)) //

// Structure Tensor "Push Forward": FH = dE/dF; Note: PK1 = dPsi/dF = dPsi/dE dE/dF. 
macro FH11(sgn) (H11*F11) //
macro FH12(sgn) (F12*H22+F13*H23(sgn)) //
macro FH13(sgn) (F12*H23(sgn)+F13*H33) //
macro FH21(sgn) (H11*F21) //
macro FH22(sgn) (F22*H22+F23*H23(sgn)) //
macro FH23(sgn) (F22*H23(sgn)+F23*H33) //
macro FH31(sgn) (H11*F31) //
macro FH32(sgn) (F32*H22+F33*H23(sgn)) //
macro FH33(sgn) (F32*H23(sgn)+F33*H33) //

// First Piola-Kirchoff Stress: P = dPsi/dF 
macro P11() (c*F11+p*cof11+2.*dpsi(1.)*FH11(1.)+2.*dpsi(-1.)*FH11(-1.)) //
macro P12() (c*F12+p*cof12+2.*dpsi(1.)*FH12(1.)+2.*dpsi(-1.)*FH12(-1.)) //
macro P13() (c*F13+p*cof13+2.*dpsi(1.)*FH13(1.)+2.*dpsi(-1.)*FH13(-1.)) //
macro P21() (c*F21+p*cof21+2.*dpsi(1.)*FH21(1.)+2.*dpsi(-1.)*FH21(-1.)) //
macro P22() (c*F22+p*cof22+2.*dpsi(1.)*FH22(1.)+2.*dpsi(-1.)*FH22(-1.)) //
macro P23() (c*F23+p*cof23+2.*dpsi(1.)*FH23(1.)+2.*dpsi(-1.)*FH23(-1.)) //
macro P31() (c*F31+p*cof31+2.*dpsi(1.)*FH31(1.)+2.*dpsi(-1.)*FH31(-1.)) //
macro P32() (c*F32+p*cof32+2.*dpsi(1.)*FH32(1.)+2.*dpsi(-1.)*FH32(-1.)) //
macro P33() (c*F33+p*cof33+2.*dpsi(1.)*FH33(1.)+2.*dpsi(-1.)*FH33(-1.)) //

// -------------- Jacobian & Residual Build Macros --------------
// Stress Function 1: psi_fi'' = d^2Psi_fi/dE^2
macro d2psi(sgn) (k1*(1.+2.*k2*Es(sgn)^2)*exp(k2*Es(sgn)^2)) //

// Standard Components: G := Grad dX & W := Grad V 
macro G11() (dx(dX)) //
macro W11() (dx(V1)) //
macro G12() (dy(dX)) //
macro W12() (dy(V1)) //
macro G13() (dz(dX)) //
macro W13() (dz(V1)) //
macro G21() (dx(dY)) //
macro W21() (dx(V2)) //
macro G22() (dy(dY)) //
macro W22() (dy(V2)) //
macro G23() (dz(dY)) //
macro W23() (dz(V2)) //
macro G31() (dx(dZ)) //
macro W31() (dx(V3)) //
macro G32() (dy(dZ)) //
macro W32() (dy(V3)) //
macro G33() (dz(dZ)) //
macro W33() (dz(V3)) //

// cofG := cofF : G & cofW := cofF : W
macro cofG() (cof11*G11+cof12*G12+cof13*G13+cof21*G21+cof22*G22+cof23*G23+cof31*G31+cof32*G32+cof33*G33) //
macro cofW() (cof11*W11+cof12*W12+cof13*W13+cof21*W21+cof22*W22+cof23*W23+cof31*W31+cof32*W32+cof33*W33) //

// CG := (cofF)^T G & CW := (cofF)^T W
macro CG11() (cof11*G11+cof21*G21+cof31*G31) //
macro CW11() (cof11*W11+cof21*W21+cof31*W31) //
macro CG12() (cof11*G12+cof21*G22+cof31*G32) //
macro CW12() (cof11*W12+cof21*W22+cof31*W32) //
macro CG13() (cof11*G13+cof21*G23+cof31*G33) //
macro CW13() (cof11*W13+cof21*W23+cof31*W33) //
macro CG21() (cof12*G11+cof22*G21+cof32*G31) //
macro CW21() (cof12*W11+cof22*W21+cof32*W31) //
macro CG22() (cof12*G12+cof22*G22+cof32*G32) //
macro CW22() (cof12*W12+cof22*W22+cof32*W32) //
macro CG23() (cof12*G13+cof22*G23+cof32*G33) //
macro CW23() (cof12*W13+cof22*W23+cof32*W33) //
macro CG31() (cof13*G11+cof23*G21+cof33*G31) //
macro CW31() (cof13*W11+cof23*W21+cof33*W31) //
macro CG32() (cof13*G12+cof23*G22+cof33*G32) //
macro CW32() (cof13*W12+cof23*W22+cof33*W32) //
macro CG33() (cof13*G13+cof23*G23+cof33*G33) //
macro CW33() (cof13*W13+cof23*W23+cof33*W33) //

// trCGCW := Tr(CG*CW)
macro trCGCW() (CG11*CW11+CG12*CW21+CG13*CW31+CG21*CW12+CG22*CW22+CG23*CW32+CG31*CW13+CG32*CW23+CG33*CW33) //

// FHG := FH : G & FHW := FH : W
macro FHG(sgn) (FH11(sgn)*G11+FH12(sgn)*G12+FH13(sgn)*G13+FH21(sgn)*G21+FH22(sgn)*G22+FH23(sgn)*G23+FH31(sgn)*G31+FH32(sgn)*G32+FH33(sgn)*G33) //
macro FHW(sgn) (FH11(sgn)*W11+FH12(sgn)*W12+FH13(sgn)*W13+FH21(sgn)*W21+FH22(sgn)*W22+FH23(sgn)*W23+FH31(sgn)*W31+FH32(sgn)*W32+FH33(sgn)*W33) //

macro trWHG(sgn) (W11*H11*G11+W12*(H22*G12+H23(sgn)*G13)+W13*(H23(sgn)*G12+H33*G13)+W21*H11*G21+W22*(H22*G22+H23(sgn)*G23)+W23*(H23(sgn)*G22+H33*G23)+W31*H11*G31+W32*(H22*G32+H23(sgn)*G33)+W33*(H23(sgn)*G32+H33*G33)) //

macro KUU() (c*(G11*W11+G12*W12+G13*W13+G21*W21+G22*W22+G23*W23+G31*W31+G32*W32+G33*W33)
   + p/Jdet*(cofG*cofW-trCGCW)
   + 4.*d2psi(1.)*FHW(1.)*FHG(1.) + 4.*d2psi(-1.)*FHW(-1.)*FHG(-1.)
   + 2.*dpsi(1.)*trWHG(1.) + 2.*dpsi(-1.)*trWHG(-1.)) //

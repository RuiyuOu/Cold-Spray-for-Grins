load "iovtk" 

include "HyperelasticityParameters.idp"
LoadDyn	= false;
LoadSta	= false;
include "HyperelasticityGeometry.idp"
include "HyperelasticityMacros.idp"
include "HyperelasticityStaticFunctions.idp"

real BisectLow  = min(0,SearchInit);
real BisectHigh = max(0,SearchInit);
real Residue; real ResidueOld;

// --- Begin Secant search ---
if( StaticSecant ){ 
  // --- Initial End Point Check --- 
  // Init Secant Search Step
  [X,Y,Z,p] = [0,0,z*SearchInit/Lz,0]; // 0 On the bottom, SearchInit at the top
  // Search
  SecantSolve
  // Convergence check
  if( abs(Residue) < SearchErr ){
  cout << "Bisection converged in " << i << " steps. Error: " << abs(Residue) << endl; 
  break;}

  // --- Begin Secant Loop ---
  for( int i = 0; i < SearchMaxIter; i++){
    // Init Secant Search Step
	UpdateSecant(Residue, ResidueOld)
    [X,Y,Z,p] = [X,Y,z*SearchInit/Lz,p]; // Copy last state which should be closer than 0.
    // Search
	SecantSolve
    // Convergence check
    if( abs(Residue) < SearchErr ){
    cout << "Bisection converged in " << i << " steps. Error: " << abs(Residue) << endl; 
    break;}

  } // End Secant Loop
} // End Secant

// --- Begin Bisection search ---
else{
  // --- Initial End Point Check --- 
  // Init Bisect Search Step
  [X,Y,Z,p] = [0,0,z*SearchInit/Lz,0]; // 0 On the bottom, SearchInit at the top
  // Search
  BisectSolve
  // Check convergence
  if( abs(Residue) < SearchErr ){
  cout << "Bisection converged on the input boundary. Error: " << abs(Residue) << endl; 
  break;}

  // --- Begin Bisect Loop ---
  for( int i = 0; i < SearchMaxIter; i++){
    // Init Bisect Search Step
    SearchInit = (BisectHigh-BisectLow)/2;
    [X,Y,Z,p] = [X,Y,z*SearchInit/Lz,p]; // Copy last state which should be closer than 0.
    // Search
    BisectSolve
    // Convergence check
    if( abs(Residue) < SearchErr ){
    cout << "Bisection converged in " << i << " steps. Error: " << abs(Residue) << endl; 
    break;}
    // Update Bisect Bounds
    UpdateBisect(Residue)

  } // End Bisect Loop
} // End Bisect

// ------ Save data ------

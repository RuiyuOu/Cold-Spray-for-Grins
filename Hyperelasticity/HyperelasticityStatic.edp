load "iovtk" 

include "HyperelasticityParameters.idp"
//LoadDyn	= false;
//LoadSta	= false;
include "HyperelasticityGeometry.idp"
include "HyperelasticityMacros.idp"
include "HyperelasticityStaticFunctions.idp"

real SearchLow  = min(0.,SearchInit);
real SearchHigh = max(0.,SearchInit);
real Residue; real ResidueLow = 0; real ResidueHigh;
real AbsErr; real RelErr;

// --- Begin Secant search ---
if( StaticSecant ){ 
  // --- Initial End Point Check --- 
  // Init Secant Search Step
  [X,Y,Z,p] = [0,0,z*SearchInit/Lz,-c]; // 0 On the bottom, SearchInit at the top
  // Solve physics
  StaticSolve
  // Solve residue
  StaticResidue
  // Convergence check
  if( abs(Residue) < SearchErr ){
  cout << "Secant converged on the input boundary. Error: " << abs(Residue) << endl;}

  // --- Begin Secant Loop ---
  else{
  ResidueHigh = Residue;
  SearchInit = SearchHigh - ResidueHigh*(SearchHigh-SearchLow)/(ResidueHigh-ResidueLow);
  for( int i = 0; i < SearchMaxIter; i++){
    // Init Secant Search Step
    [X,Y,Z,p] = [X,Y,z*SearchInit/Lz,p]; // Copy last state which should be closer than 0.
    // Solve physics
	StaticSolve
    // Solve residue
    StaticResidue
    // Convergence check
    if( abs(Residue) < SearchErr ){
    cout << "Secant converged in " << i << " steps. Error: " << abs(Residue) << endl; 
    break;}
    UpdateSecant
  } // End For
  } // End Secant Loop
} // End Secant

// --- Begin Bisection search ---
else{
  // --- Initial End Point Check --- 
  // Init Bisect Search Step
  [X,Y,Z,p] = [0,0,z*SearchInit/Lz,-c]; // 0 On the bottom, SearchInit at the top
  // Solve physics
  StaticSolve
  // Solve residue
  StaticResidue
  // Check convergence
  if( abs(Residue) < SearchErr ){
  cout << "Bisection converged on the input boundary. Error: " << abs(Residue) << endl;}

  // --- Begin Bisect Loop ---
  else{
  SearchInit = (SearchHigh+SearchLow)/2;
  for( int i = 0; i < SearchMaxIter; i++){
    // Init Bisect Search Step
    [X,Y,Z,p] = [X,Y,z*SearchInit/Lz,p]; // Copy last state which should be closer than 0.
    // Search
    StaticSolve
    // Solve residue
    StaticResidue
    // Convergence check
    if( abs(Residue) < SearchErr ){
    cout << "Bisection converged in " << i << " steps. Error: " << abs(Residue) << endl; 
    break;}
    // Update Bisect Bounds
    UpdateBisect
  } // End For
  } // End Bisect Loop
} // End Bisect

// ------ Save data ------
real T = int2d(Th,6)(P33);
real uzmean = int2d(Th,6)(Z)/int2d(Th,6)(1.);
fespace P0h(Th,P0);
P0h jerr = abs(Jdet-1.);
cout << "   >> U(z=Lz) = " << uzmean << "  T = " << T << " N   max|J-1| = " << jerr[].linfty << endl;
Th = movemesh(Th,[x+X,y+Y,z+Z]);
plot(Th);
// Linear Elasticity

// Gravity
real g = -9.8;

// We will be assuming a density of 1kg/m^3
real E 		= 1E3; 	// Young's modulus: kg/m/s^2
real nu 	= 0.3;	// Poisson modulus: 1

real lambda = E*nu/((1.+nu)*(1.-2.*nu)); 	// Lame parameter: Pa
real mu 	= E/(2.*(1.+nu));				// Lame parameter: Pa

// Elastic tensor
func Elas = [[2*mu+lambda,	lambda, 		0. ], 
			 [lambda,		2*mu+lambda, 	0. ],
			 [ 0. , 		0. , 			mu ]];

// Divergence
macro div(v) (dx(v[0])+dy(v[1])) // 	
// Strain vector
macro eps(v) ([dx(v[0]),dy(v[1]),dy(v[0])+dx(v[1])]) //

// Macros M and K as described in the PDF
macro M(a) (a[0]*pvi+a[1]*pvj) //
macro K(a) (lambda*(div(a)*div([pvi,pvj]))+2.*muK*mu*eps(a)'*eps([pvi,pvj])) //

// Beta Newmark constants
func real c0(real dt, real beta, real gamma){return 1./(beta*dt*dt);}
func real c1(real dt, real beta, real gamma){return 1./(beta*dt);}
func real c2(real dt, real beta, real gamma){return 1./(2.*beta) - 1.;}
func real c3(real dt, real beta, real gamma){return gamma/(beta*dt);}
func real c4(real dt, real beta, real gamma){return gamma/beta - 1.;}
func real c5(real dt, real beta, real gamma){return dt*(gamma/(2*beta) - 1.);}

// Wave speeds
real ps = sqrt((lambda+2*mu));
real ss = sqrt(mu);

// Time step size
func real TimeStepSize(real GridSize){
	return GridSize/ps;
}

// Active Contact functions

bool Persistence = false;

// Shows if 2 blocks of materials are in active compression
func real Compression(){
	return 0;
	}

// Shows if 2 blocks of materials are actively overlapping
func real Overlap(mesh Th1,mesh Th2){
	return (int2d(Th1)(chi(Th2)(x,y))+int2d(Th2)(chi(Th1)(x,y)));
	}

// Boolean to identify active contact between bodies	
func bool ContactActive(mesh Th1, mesh Th2){

	if (Persistence == true){
		if (Compression() > 0){
			return true;}
		else{return false;}
	}

	else {
		if(Overlap(Th1,Th2) > 0){
			return true;
		}
		else{return false;}
	}

}
// Newark Constants
func real c0(real dt, real beta, real gamma){return 1./(beta*dt*dt);}
func real c1(real dt, real beta, real gamma){return gamma/(beta*dt);}
func real c2(real dt, real beta, real gamma){return 1./(beta*dt);}
func real c3(real dt, real beta, real gamma){return gamma/beta;}
func real c4(real dt, real beta, real gamma){return 1./(2.*beta);}
func real c5(real dt, real beta, real gamma){return dt*(gamma/(2.*beta)-1.);}
func real c6(real dt, real beta, real gamma){return 1.-gamma/beta;}
func real c7(real dt, real beta, real gamma){return -1.*c5(dt,beta,gamma);}

func bool ActiveContact(real[int] Contact){return Contact.max >= 1;}

macro UpdateKinematics(dx,x,v,a,C1,C6,C7,M,C,K,Ext)
{
x[] += dx[];
v[] *= C6; v[] += C1*dx[]; v[] += C7*a[];
real[int] Residue = (-1.*C)*v1x; Residue[] += Ext; Residue[] -= K*u1x;
a[] = M^-1*Residue;
} // 


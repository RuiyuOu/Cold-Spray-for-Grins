int n = 10;

real W = 3;
real H = 2;
int nx = W*n; int ny = H*n; int nt = W/3*n;
int Bottom=1; int Right=2; int Left=3; int TopL = 4; int TopMid = 5; int TopR = 6;
border BottomBorder(t=0,1) { x = W*t;                    y = 0;   label = Bottom; }
border RightBorder(t=0,1)  { x = W;                       y = H*t; label = Right; }
border TopRBorder(t=0,1)   { x = W - (W/3.0)*t;           y = H;   label = TopR; }    // W     -> 2W/3
border TopMidBorder(t=0,1) { x = 2.0*W/3.0 - (W/3.0)*t;   y = H;   label = TopMid; }  // 2W/3  -> W/3
border TopLBorder(t=0,1)   { x = W/3.0 - (W/3.0)*t;       y = H;   label = TopL; }    // W/3   -> 0
border LeftBorder(t=0,1)   { x = 0;                       y = H*(1-t); label = Left; }

mesh Th = buildmesh(BottomBorder(nx) + RightBorder(ny) + TopRBorder(nt) + TopMidBorder(nt) + TopLBorder(nt) + LeftBorder(ny));

plot(Th, wait=true);

real E  = 1e3;
real nu = 0.3;
real mu     = E/(2.0*(1.0+nu));
real lambda = E*nu/((1.0+nu)*(1.0-2.0*nu));

// ---------- Displacement field ----------
fespace Vh(Th, [P2,P2]);
Vh [u,v];
Vh [uu,vv];
Vh [delx,dely];

real sqrt2 = sqrt(2.0);
macro div(v) (dx(v[0])+dy(v[1])) //
macro eps(v) ([dx(v[0]),dy(v[1]),(dy(v[0])+dx(v[1]))/sqrt2]) //

solve Elasticity([u,v],[uu,vv])
  = int2d(Th)(
        lambda*(div([u,v])*div([uu,vv]))
      + 2.0*mu*( eps([u,v])'*eps([uu,vv]) )
    )
	+int2d(Th)(vv)
  + on(Bottom, u=0, v=0)
  + on(TopMid, u=0, v=-0.3)
  ;


fespace Sh(Th, P1);
Sh Sxx = lambda*div([u,v]) + 2.0*mu*dx(u);
Sh Syy = lambda*div([u,v]) + 2.0*mu*dy(v);
Sh Sxy = mu*(dy(u)+dx(v));
Sh Szz = lambda*div([u,v]);

Sh VonMises = sqrt( 0.5*((Sxx-Syy)^2 + (Syy-Szz)^2 + (Szz-Sxx)^2) + 3.0*Sxy^2 );
mesh Thd = movemesh(Th, [x+u, y+v]);

fespace Shd(Thd, P1);
Shd VonMisesD = VonMises;

plot(Thd, wait=true, cmm="Deformed mesh");
plot(Thd, VonMisesD, fill=true, value=true, wait=true,
     cmm="von Mises stress [MPa], deformed configuration");

func midThird = (x >= W/3.0)*(x <= 2.0*W/3.0)*(y==2);
Vh [ind1,ind2] = [midThird,midThird];
varf DirMaskVecTop([delx,dely],[uu,vv]) = on(TopR,TopMid,TopL,delx=1,dely=1);
varf DirMaskBottom([delx,dely],[uu,vv]) = on(Bottom,delx=1,dely=1);
Vh [aux1,aux2];

real[int] MT=DirMaskVecTop(0,Vh, tgv=1);
real[int] MB=DirMaskBottom(0,Vh, tgv=1);
aux1[] = MT;
aux1[] = ind1[].*aux1[];
aux1[] += MB;
plot(aux1,wait=1,value=true);

varf  Lame([u,v],[uu,vv]) =
  int2d(Th)(
        lambda*(div([u,v])*div([uu,vv]))
      + 2.0*mu*( eps([u,v])'*eps([uu,vv]) )
    )
	+int2d(Th)(vv)
;
Vh [gx,gy] = [0,-0.3];
real[int] topMask = ind1[].*MT;
real[int] g = topMask .* gx[];
matrix A = Lame(Vh,Vh,sym=1,positive=1,solver="CG");
real[int] b0 = Lame(0,Vh);
real[int] bBC = A*g;
real[int] b = b0 - bBC;
setBC(A,aux1[],-2);
set(A,solver= "CHOLMOD");
//b =  aux1[] ? 0 : b;
b = aux1[] ? g : b;
delx[] = A^-1*b;

mesh ThM = movemesh(Th,[x+u-delx,y+v-dely]);
plot(ThM,wait=1);

Vh [diffx, diffy]= [u-delx , v-dely];
cout << diffx[].max << endl;
cout << diffy[].max << endl;
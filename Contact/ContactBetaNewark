load "iovtk"
include "ContactGeometry"
include "ContactElasticity"

string outdir = "..//Contact//results//";
string filenum;

// Beta Newark parameters
real beta 	= 0.25;
real gamma 	= 0.5;

// Rayleigh dampening terms
real AlphaM 	= 0.01;
real AlphaK 	= 0.01;

// Lame scaling term
real muK = 3e-2;

real T 		= 10;
real MinGridSize = pCFL[].min;
real dt 	= TimeStepSize(MinGridSize);
real steps 	= T/dt;	

// Waves 
fespace Wh(Ph,P1);
Wh pw;
Wh sw;

// Initial conditions
pxx[] 	= 0;
pxxo[]  = 0;
pvx[] 	= 0;
pvxo[] 	= 0;
pax[]	= 0;
paxo[]	= 0;

int[int] vtkorder = [1,1,1];

real C0 = c0(dt,beta,gamma);
real C1 = c1(dt,beta,gamma);
real C2 = c2(dt,beta,gamma);
real C3 = c3(dt,beta,gamma);
real C4 = c4(dt,beta,gamma);
real C5 = c5(dt,beta,gamma);

problem BetaNewark([pxx,pyy],[pvi,pvj])
	= int2d(Ph)(
              	C0*M([pxx,pyy])+
				AlphaM*C3*M([pxx,pyy])+
				AlphaK*C3*K([pxx,pyy])+
				K([pxx,pyy])
				)
    - int2d(Ph)(
				C0*M([pxxo,pyyo]) + C1*M([pvxo,pvyo]) + C2*M([paxo,payo])+
				AlphaM*(C3*M([pxxo,pyyo]) + C4*M([pvxo,pvyo]) + C5*M([paxo,payo]))+
				AlphaK*(C3*K([pxxo,pyyo]) + C4*K([pvxo,pvyo]) + C5*K([paxo,payo]))+
				g*pvj
				)
    + on(bottom, pyy=0);

for (int n = 0; n < steps; n++)
{
    real t  = (n+1)*dt;

    BetaNewark;
	
	// Update the fields

    // New acceleration from Newmark
    // uan = c0*(pxx - pxxo) - c1*pvxo - c2*paxo
    pax[] = pxx[];
    pax[] -= pxxo[];
    pax[] *= C0;
    pax[] -= C1*pvxo[];
    pax[] -= C2*paxo[];

    // New velocity from Newark
	// uvn = c3*(pxx - pxxo) - c4*pvxo - c5*paxo
    pvx[] = pxx[];
	pvx[] -= pxxo[];
	pvx[] *= C3;
    pvx[] -= C4*pvxo[];
	pvx[] -= C5*paxo[];

    pxxo[] = pxx[];
	paxo[] = pax[];
	pvxo[] = pvx[];
	
	// Save data

	// Block deformation
	mesh PhDeformed = movemesh(Ph, [x+pxx, y+pyy]);
	// Pressure and shear waves 
	pw = dx(pxx)+dy(pyy);
	sw = dy(pxx)-dx(pyy);

	if (n%5==0){
		if 		(n < 10) 	filenum = "000"	+n;
		else if (n < 100) 	filenum = "00"	+n;
		else if (n < 1000)	filenum = "0"   +n;
		else 				filenum = n;
	
    	savevtk(outdir+"betanewark"+filenum+".vtu", 
				PhDeformed, 
				[pxx,pyy], pw, sw, 
				dataname="displacement pressurewave shearwave",
				order=vtkorder);
	}
}
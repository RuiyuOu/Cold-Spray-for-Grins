int bottom = 1;
int right = 2;
int top = 3;
int left = 4;
int circle = 5;

int nn = 10;

border S1(t=0,1){ x=5*t;   y=0;   label=bottom; }
border S2(t=0,1){ x=5;   y=1*t;   label=right; }
border S3(t=0,1){ x=5-5*t; y=1;   label=top; }
border S4(t=0,1){ x=0;   y=1-1*t; label=left; }
border S5(t=0,2*3.14159265){x=2.5+0.5*cos(t); y=2+0.5*sin(t); label=circle;}

mesh Ph = buildmesh(S1(5*nn)+S2(nn)+S3(5*nn)+S4(nn));
meshL BPh = extract(Ph);
mesh Ch = buildmesh(S5(5*nn));
meshL BCh = extract(Ph);

fespace UhP(Ph,[P1,P1]);
UhP [pxx,pyy];
UhP [pxxo,pyyo];
UhP [pvx,pvy];
UhP [pvxo,pvyo];
UhP [pax,pay];
UhP [paxo,payo];
UhP [pvi,pvj];

fespace LChP(BPh,P0);
LChP ContP;	// Boolean 0 and 1 for surface in contact or not

fespace LhP(BPh,P1);
LhP TractPx, TractPy;

fespace UhC(Ch,[P1,P1]);
UhC [cxx,cyy];
UhC [cxxo,cyyo];
UhC [cvx,cvy];
UhC [cvxo,cvyo];
UhC [cax,cay];
UhC [caxo,cayo];
UhC [cvi,cvj];

fespace LChC(BCh,P0);
LChC ContC;	// Boolean 0 and 1 for surface in contact or not

fespace LhC(BCh,P1);
LhP TractCx, TractCy;

// CFL information
fespace PCFL(Ph,P0);
PCFL pCFL = hTriangle;

// CFL information
fespace CCFL(Ch,P0);
PCFL cCFL = hTriangle;
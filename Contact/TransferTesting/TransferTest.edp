load "msh3"
include "ContactGeometry.idp" 

meshL PL = extract(Ph);
meshL CL = extract(Ch);
mesh MovedCh = movemesh(Ch,[x,y-0.7]);
meshL MovedCL = movemesh(CL,[x,y-0.7]);
real[int] InteriorPoint = [2.5, -0.03];
real[int] BoundaryPoint = [2.5, 0];

ShC TransferTest = x;
fespace MovedShC(MovedCh,P1);
MovedShC MovedTransferTest = x;
plot(TransferTest,wait=true,fill=true,value=true);

// Mesh to Border - NonOverlapping
fespace MBN(Ph,P1);
MBN DistMBN = dist(CL);
MBN ProjXMBN = projection(CL).x-x;
MBN ProjYMBN = projection(CL).y-y;
MBN MBNProjTest = TransferTest(projection(CL).x,projection(CL).y);
plot(MBNProjTest,[ProjXMBN,ProjYMBN],TransferTest,wait=true,fill=true,value=true);

// Mesh to Border - Overlapping
fespace MBO(Ph,P1);
MBO DistMBO = dist(MovedCL);
MBO ProjXMBO = projection(MovedCL).x-x;
MBO ProjYMBO = projection(MovedCL).y-y;
MBO MBOProjTest = MovedTransferTest(projection(MovedCL).x,projection(MovedCL).y);
plot(MBOProjTest,[ProjXMBO,ProjYMBO],MovedTransferTest,wait=true,fill=true,value=true);
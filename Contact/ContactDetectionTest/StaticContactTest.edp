load "iovtk"
load "msh3"
int[int] vtkorder = [1,1];

// Schwarz DDM Parameters
int SchwarzIterLim = 100;
real SchwarzAbsTol = 1e-12;
real SchwarzRelTol = 1e-9;
real SchwarzRelaxation = 0.7;

// Contact Algo Parameters
real OverlapTol = 1e-9;
real CompressionTol = 0;

// Physics Parameters
real ModulusMagnitudeReduction = 2;
real g = -9.8e0;

// Small cylinder parameters
real SmallR = 1.e-2;
border SmallCirc(t=0,2*pi){ x=SmallR*cos(t); y=SmallR+SmallR*sin(t); label=1; }
mesh Small = buildmesh(SmallCirc(30));
Small = splitmesh(Small, 1 + 3*exp(-(y/0.003)^2));
real SmallE = 1.e6*(10^(-ModulusMagnitudeReduction));
real SmallNu = 0.49;
real SmallRho = 19.5e2;
real SmallForce = SmallRho*g;
fespace Sh(Small,[P1,P1]);
Sh [sdx,sdy], [sx,sy], [si,sj];
Sh [sContX,sContY], [sOldContX,sOldContY], [sMaskX,sMaskY], [sTractX,sTractY];
fespace ShS(Small, P1);
ShS sSxx, sSxy, sSyy, sSzz, sVonMises, sN;
real NetSmallForce = int2d(Small)(SmallForce);
// Large cylinder parameters
real LargeR = 2.e-2;
border LargeCirc(t=0,1){ x=LargeR-2*LargeR*t; y=0; label=2; }
border Left(t=0,1){x=-LargeR; y=-LargeR*t; label=3;};
border Right(t=0,1){x=LargeR; y=-LargeR+LargeR*t; label=4;};
border Bottom(t=0,1){x=-LargeR+2*LargeR*t; y=-LargeR; label=5;};
mesh Large = buildmesh(LargeCirc(20)+Left(10)+Right(10)+Bottom(10));
Large = splitmesh(Large, 1 + 3*exp(-(y/0.003)^2));
real LargeE = 5.e6*(10^(-ModulusMagnitudeReduction));
real LargeNu = 0.09;
real LargeRho = 1.05e3;
real AreaLarge = int2d(Large)(1.0);
real LargeForce = -NetSmallForce/AreaLarge;
fespace Lh(Large,[P1,P1]);
Lh [ldx,ldy], [lx,ly], [li,lj];
Lh [lContX,lContY], [lOldContX,lOldContY], [lMaskX,lMaskY], [lTractX,lTractY];
fespace LhS(Large, P1);
LhS lSxx, lSxy, lSyy, lSzz, lVonMises, lN; 

// macros
real sqrt2 = sqrt(2.0);
macro div(v) (dx(v[0])+dy(v[1])) //
macro eps(v) ([dx(v[0]),dy(v[1]),(dy(v[0])+dx(v[1]))/sqrt2]) //
macro Sxx(E,nu,u) (lambda(E,nu)*(dx(u[0])+dy(u[1])) + 2*mu(E,nu)*dx(u[0])) //
macro Syy(E,nu,u) (lambda(E,nu)*(dx(u[0])+dy(u[1])) + 2*mu(E,nu)*dy(u[1])) //
macro Sxy(E,nu,u) (mu(E,nu)*(dy(u[0])+dx(u[1]))) //
macro Szz(E,nu,u) (lambda(E,nu)*(dx(u[0])+dy(u[1]))) //
macro BuildMaskTensor(Mesh,FESpace, MaskTensor, ContactTensor, ifNeu){
varf LocalContactMask([u2,u1],[v1,v2]) = on(Mesh,u1=1,u2=1);
real[int] LocalEdgeIndicator=LocalContactMask(0,FESpace, tgv=1);
MaskTensor[] = LocalEdgeIndicator;
if(!ifNeu){MaskTensor[] = ContactTensor[].*MaskTensor[];}
} //
macro SolveDirichlet(Mesh, FESpace, OtherBound, DisplacementField, VecDisplacement, DisplacementIncrementField, MaskTensor, E, nu, force) {
VecDisplacement = [projection(OtherBound).x-x,projection(OtherBound).y-y];
real LocalLambda = lambda(E,nu);
real LocalMu     = mu(E,nu);
varf LocalLame([u,v],[uu,vv]) =
    int2d(Mesh)( LocalLambda*(div([u,v])*div([uu,vv])) + 2.0*LocalMu*(eps([u,v])'*eps([uu,vv])) )
  + int2d(Mesh)( force*vv );
matrix LocalA = LocalLame(FESpace,FESpace,sym=1,positive=1,solver="CHOLMOD");
real[int] LocalStressHistory = LocalA*DisplacementField[];
real[int] Localb0 = LocalLame(0,FESpace);
Localb0 = Localb0 - LocalStressHistory;
real[int] Localg = MaskTensor[].*DisplacementIncrementField[];
real[int] LocalbBS = LocalA*Localg;
real[int] Localb = Localb0 - LocalbBS;
Localb = MaskTensor[] ? Localg : Localb;
setBC(LocalA,MaskTensor[],-2);
DisplacementIncrementField[] = LocalA^-1*Localb;
} //
macro SolveNeumann(Mesh, FESpace, Bound, OtherBound, DisplacementField, DisplacementIncrementField, TractionField, OtherTractionField, ContactTensor, MaskTensor, E, nu, force){
TractionField = [OtherTractionField[0](projection(OtherBound).x,projection(OtherBound).y),OtherTractionField[1](projection(OtherBound).x,projection(OtherBound).y)];
TractionField = -1*TractionField;
real LocalLambda = lambda(E,nu);
real LocalMu     = mu(E,nu);
varf LocalLame([u,v],[uu,vv]) =
    int2d(Mesh)( LocalLambda*(div([u,v])*div([uu,vv])) + 2.0*LocalMu*(eps([u,v])'*eps([uu,vv])) )
  + int1d(Mesh, Bound)( (ContactTensor.*TractionField)'*[uu,vv]);
matrix LocalA = LocalLame(FESpace,FESpace,solver="CG");
real[int] LocalStressHistory = LocalA*DisplacementField[];
real[int] Localb0 = LocalLame(0,FESpace);
Localb0 = Localb0 - LocalStressHistory;
real[int] Localg = MaskTensor[].*DisplacementIncrementField[];
real[int] LocalbBS = LocalA*Localg;
real[int] Localb = Localb0 - LocalbBS;
Localb = MaskTensor[] ? Localg : Localb;
setBC(LocalA,MaskTensor[],-2);
DisplacementIncrementField[] = LocalA^-1*Localb;
} //
macro UpdateContact(Mesh, OtherMesh, ContactTensor, VecContactTensor, OldContactTensor, VecOldContactTensor, Sigma, TractionField, NormalTraction){
VecContactTensor = [(dist(OtherMesh) < OverlapTol), (dist(OtherMesh) < OverlapTol)];
for (int k = 0; k < Mesh.nbe; k++){
  real nx = Mesh.be(k).N.x, ny = Mesh.be(k).N.y;
  for (int i = 0; i < 2; i++){
    int iv = int(Mesh.be(k)[i]);
    real sxx = Sigma[0][][iv], sxy = Sigma[2][][iv], syy = Sigma[1][][iv];
    TractionField[][2*iv]   = (sxx*nx + sxy*ny);
    TractionField[][2*iv+1] = (sxy*nx + syy*ny);
	NormalTraction[][iv] = TractionField[][2*iv]*nx+TractionField[][2*iv+1]*ny;
  }
}
VecOldContactTensor = [1,1] - VecOldContactTensor;
ContactTensor[] = ContactTensor[].*OldContactTensor[];
VecOldContactTensor = [1,1] - VecOldContactTensor;
VecContactTensor = VecContactTensor + VecOldContactTensor*(NormalTraction < 0);
} //
macro UpdateStress(Sigma, Displacement, E, nu){
Sigma[0] = Sxx(E,nu,Displacement);
Sigma[1] = Syy(E,nu,Displacement);
Sigma[2] = Sxy(E,nu,Displacement);
Sigma[3] = Szz(E,nu,Displacement);
} //

// functions
func real lambda(real E, real nu){return E*nu/((1+nu)*(1-2*nu));}
func real mu(real E, real nu){return E/(2*(1+nu));}

Small = movemesh(Small,[x,y-5.e-4]);
[sdx,sdy]=[sdx,sdy]; [sx,sy]=[sx,sy]; [si,sj]=[si,sj]; [sContX,sContY]=[sContX,sContY]; [sOldContX,sOldContY]=[sContX,sContY]; [sMaskX,sMaskY]=[sMaskX,sMaskY]; [sTractX,sTractY]=[sTractX,sTractY];
sSxx=sSxx; sSxy=sSxy; sSyy=sSyy; sSzz=sSzz; sVonMises = sqrt( 0.5*((sSxx-sSyy)^2 + (sSyy-sSzz)^2 + (sSzz-sSxx)^2) + 3.0*sSxy^2 ); sN=sN;

for( int iter = 0; iter < SchwarzIterLim; iter++){
meshL SmallBound = extract(Small);
meshL LargeBound = extract(Large);
UpdateContact(Small, Large, sContX, [sContX,sContY], sOldContX, [sOldContX,sOldContY], [sSxx,sSyy,sSxy], sTractX, sN)
UpdateContact(Large, Small, lContX, [lContX,lContY], lOldContX, [lOldContX,lOldContY], [lSxx,lSyy,lSxy], lTractX, lN)
BuildMaskTensor(SmallCirc,Sh,sMaskX,sContX,false)
BuildMaskTensor(Bottom,Lh,lMaskX,lContX,true)
SolveDirichlet(Small,Sh,LargeBound,sx,[sdx,sdy],sdx,sMaskX,SmallE,SmallNu,SmallForce)
[sdx,sdy] =  SchwarzRelaxation*[sdx,sdy];
[sx,sy] = [sx,sy] + [sdx,sdy];
UpdateStress([sSxx,sSyy,sSxy,sSzz],[sx,sy],SmallE,SmallNu);
SolveNeumann(Large,Lh,LargeCirc, SmallBound,lx,ldx,[lTractX,lTractY],[sTractX,sTractY],[lContX,lContY],lMaskX,LargeE,LargeNu,LargeForce)
[ldx,ldy] =  SchwarzRelaxation*[ldx,ldy];
[lx,ly] = [lx,ly] + [ldx,ldy];
UpdateStress([lSxx,lSyy,lSxy,lSzz],[lx,ly],LargeE,LargeNu);
cout << max(sdx[].linfty, sdy[].linfty) << endl;
cout << max(ldx[].linfty, ldy[].linfty) << endl;
Small = movemesh(Small,[x+sdx,y+sdy]);
Large = movemesh(Large,[x+ldx,y+ldy]);
[sdx,sdy]=[sdx,sdy]; [sx,sy]=[sx,sy]; [si,sj]=[si,sj]; [sContX,sContY]=[sContX,sContY]; [sOldContX,sOldContY]=[sContX,sContY]; [sMaskX,sMaskY]=[sMaskX,sMaskY]; [sTractX,sTractY]=[sTractX,sTractY];
sSxx=sSxx; sSxy=sSxy; sSyy=sSyy; sSzz=sSzz; sVonMises = sqrt( 0.5*((sSxx-sSyy)^2 + (sSyy-sSzz)^2 + (sSzz-sSxx)^2) + 3.0*sSxy^2 ); sN=sN;
[ldx,ldy]=[ldx,ldy]; [lx,ly]=[lx,ly]; [li,lj]=[li,lj]; [lContX,lContY]=[lContX,lContY]; [lOldContX,lOldContY]=[lContX,lContY]; [lMaskX,lMaskY]=[lMaskX,lMaskY]; [lTractX,lTractY]=[lTractX,lTractY];
lSxx=lSxx; lSxy=lSxy; lSyy=lSyy; lSzz=lSzz; lVonMises = sqrt( 0.5*((lSxx-lSyy)^2 + (lSyy-lSzz)^2 + (lSzz-lSxx)^2) + 3.0*lSxy^2 ); lN=lN;

// Save data 
mesh Combined = Small + Large;
fespace CombinedSpace(Combined,P1); 
CombinedSpace VonMises = sVonMises*chi(Small)(x,y) + lVonMises*chi(Large)(x,y);
CombinedSpace ContactPoints = sContX*chi(Small)(x,y) + lContX*chi(Large)(x,y);
string filename;
if(iter < 10) filename = "Data0"+iter;
else filename = "Data"+iter;
savevtk(filename+".vtu", Combined, VonMises, ContactPoints, dataname="VonMises ContactPoints", order=vtkorder);
if (max(max(sdx[].linfty, sdy[].linfty),max(ldx[].linfty, ldy[].linfty) || ((max(max(sdx[].linfty, sdy[].linfty),max(ldx[].linfty, ldy[].linfty)) / max(max(max(sdx[].linfty, sdy[].linfty),max(ldx[].linfty, ldy[].linfty)),1e-21)))< SchwarzRelTol ) < SchwarzAbsTol ){cout << "Iterations needed: " << iter <<endl; break;}
}
// 